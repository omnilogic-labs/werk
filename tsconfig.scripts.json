{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun-types"],
    "skipLibCheck": true,
    "typeRoots": ["packages/werk/node_modules"],
    "allowImportingTsExtensions": true,
    "moduleDetection": "force"
  },
  "include": ["scripts"]
}
