{
  "name": "werk-poc",
  "version": "0.0.0",
  "private": true,
  "description": "Proof of concept for the werk stack. Reference material, not product code.",
  "type": "module",
  "bin": {
    "wp": "./dist/wp"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/client",
    "test": "bun test",
    "build": "bun run build:web && bun build --compile ./src/cli/main.ts --outfile ./dist/wp",
    "m0": "bun run ./spikes/m0/run-all.ts",
    "m2": "bun run ./spikes/m2/run-all.ts",
    "m3": "bun run ./spikes/m3/snapshot-cost.ts && bun run ./spikes/m3/cross-commit.ts",
    "m5": "bun run ./spikes/m5/run.ts",
    "build:web": "bun run ./src/web/build.ts"
  },
  "devDependencies": {
    "@types/escape-html": "^1.0.4",
    "bun-types": "1.3.14",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@beamterm/renderer": "^1.0.0",
    "@wterm/core": "^0.4.1",
    "@wterm/dom": "^0.4.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "6",
    "atomically": "^2.1.1",
    "escape-html": "^1.0.3",
    "libghostty-vt": "^0.6.3"
  }
}
