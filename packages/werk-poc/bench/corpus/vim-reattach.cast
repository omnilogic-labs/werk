[0.01277,"o","\u001b[1;1H\u001b[34m// The engine seam from the proposal, §\u001b[1;40H5: one interface, adapters chosen per\r\n// session at runtime. Every capability an adapter lacks comes back as an\u001b[m\u001b[2;74H\u001b[K\u001b[3;1H\u001b[34m// `Unsupported` value rather than a throw, so the capability matrix is\u001b[m\u001b[3;72H\u001b[K\u001b[4;1H\u001b[34m// output of the program rather than a hand-maintained table.\r\n\r\n/** A capability this engine does not provide. Returned, never thrown. */\u001b[m\r\n\u001b[38;5;130mexport\u001b[m \u001b[38;5;130mclass\u001b[m Unsupported \u001b[36m{\u001b[m\r\n  \u001b[32mreadonly\u001b[m \u001b[36munsupported\u001b[m = \u001b[31mtrue\u001b[m \u001b[35mas\u001b[m \u001b[36mconst\u001b[m;\r\n  \u001b[36mconstructor\u001b[m(\u001b[32mreadonly\u001b[m\u001b[35m reason\u001b[m:\u001b[35m \u001b[m\u001b[32mstring\u001b[m) \u001b[36m{}\r\n}\u001b[m\r\n\r\n\u001b[38;5;130mexport\u001b[m \u001b[38;5;130mfunction\u001b[m \u001b[36misUnsupported\u001b[m(\u001b[35mv\u001b[m:\u001b[35m \u001b[m\u001b[32munknown\u001b[m): \u001b[36mv\u001b[m \u001b[38;5;130mis\u001b[m \u001b[36mUnsupported\u001b[m \u001b[36m{\u001b[m\r\n  \u001b[38;5;130mreturn\u001b[m v \u001b[38;5;130minstanceof\u001b[m Unsupported;\r\n\u001b[36m}\u001b[m\r\n\r\n\u001b[34m/** Keys are the seam's method names; true means the adapter implements it. */\u001b[m\r\n\u001b[38;5;130mexport\u001b[m \u001b[38;5;130mtype \u001b[m\u001b[36mCapabilities \u001b[m\u001b[38;5;130m=\u001b[m \u001b[36mReadonly\u001b[m<\u001b[36mRecord\u001b[m<\u001b[36mCapabilityName\u001b[m, \u001b[32mboolean\u001b[m>>;\r\n\r\n\u001b[38;5;130mexport\u001b[m \u001b[38;5;130mtype \u001b[m\u001b[36mCapabilityName \u001b[m\u001b[38;5;130m=\r\n\u001b[m  \u001b[38;5;130m|\u001b[m \u001b[31m\"write\"\u001b[m\r\n  \u001b[38;5;130m|\u001b[m \u001b[31m\"resize\"\u001b[m\r\n  \u001b[38;5;130m|\u001b[m \u001b[31m\"plainText\"\u001b[m\r\n  \u001b[38;5;130m|\u001b[m \u001b[31m\"styledCells\"\u001b[m\u001b